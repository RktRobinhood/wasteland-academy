[node name="AudioHud" type="CanvasLayer"]
layer = 100
script = ExtResource("1_script")

[node name="Overlay" type="Control" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
