[ext_resource type="Texture2D" path="res://assets/icons/speaker-off.svg" id="3_speaker"]
[ext_resource type="Texture2D" path="res://assets/icons/settings-gear.svg" id="4_gear"]
[ext_resource type="PackedScene" path="res://scenes/settings.tscn" id="5_settings"]
