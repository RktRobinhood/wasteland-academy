{
  "$comment": "The telemetry allowlist (FAL-379 plan, FAL-406). The collector and the Godot recorder (FAL-405) both read this file: an event name or field that isn't here is never stored. Field types: string (max = most characters, pattern = a regular expression the whole value must match, strip_digits = the collector removes digits), int and number (min, max), bool, enum (values). A required field that is missing or invalid rejects the event; any other invalid or unknown field is dropped.",
  "version": 1,
  "limits": {
    "max_events": 50,
    "max_bytes": 32768
  },
  "envelope": {
    "event": { "type": "string", "required": true, "max": 32 },
    "session_id": { "type": "string", "required": true, "pattern": "^[0-9a-f]{32}$" },
    "game_version": { "type": "string", "required": true, "max": 32, "pattern": "^[0-9A-Za-z.+_-]+$" },
    "seq": { "type": "int", "min": 0, "max": 1000000 },
    "arms": {
      "type": "arms",
      "max_entries": 8,
      "key_pattern": "^[a-z0-9_-]{1,32}$",
      "value_pattern": "^[a-z0-9_-]{1,32}$"
    }
  },
  "events": {
    "session_start": {
      "platform": { "type": "enum", "required": true, "values": ["web", "desktop", "mobile"] },
      "language": { "type": "string", "max": 16, "pattern": "^[a-z]{2,3}([_-][A-Za-z0-9]{2,8})?$" },
      "screen_band": { "type": "enum", "values": ["small", "medium", "large"] }
    },
    "question_shown": {
      "view_id": { "type": "string", "required": true, "max": 200, "pattern": "^[a-z0-9][a-z0-9/_.-]*$" },
      "seed": { "type": "int", "required": true, "min": 0, "max": 9007199254740991 },
      "cell": { "type": "string", "max": 200, "pattern": "^[a-z0-9][a-z0-9/_.-]*$" },
      "mode": { "type": "enum", "values": ["practice", "probe", "exam"] }
    },
    "answer_checked": {
      "view_id": { "type": "string", "required": true, "max": 200, "pattern": "^[a-z0-9][a-z0-9/_.-]*$" },
      "seed": { "type": "int", "required": true, "min": 0, "max": 9007199254740991 },
      "correct": { "type": "bool", "required": true },
      "attempt": { "type": "int", "min": 1, "max": 99 },
      "seconds": { "type": "number", "min": 0, "max": 600 },
      "format_errors": { "type": "int", "min": 0, "max": 99 },
      "misconception": { "type": "string", "max": 64, "pattern": "^[a-z0-9][a-z0-9_.-]*$" },
      "solution_opened": { "type": "bool" }
    },
    "question_left": {
      "view_id": { "type": "string", "required": true, "max": 200, "pattern": "^[a-z0-9][a-z0-9/_.-]*$" },
      "seed": { "type": "int", "required": true, "min": 0, "max": 9007199254740991 },
      "seconds": { "type": "number", "min": 0, "max": 600 }
    },
    "generator_error": {
      "view_id": { "type": "string", "required": true, "max": 200, "pattern": "^[a-z0-9][a-z0-9/_.-]*$" },
      "seed": { "type": "int", "required": true, "min": 0, "max": 9007199254740991 },
      "message": { "type": "string", "max": 300, "strip_digits": true }
    },
    "client_error": {
      "message": { "type": "string", "required": true, "max": 300, "strip_digits": true },
      "script": { "type": "string", "max": 200, "pattern": "^res://[A-Za-z0-9/_.-]*$" },
      "line": { "type": "int", "min": 0, "max": 1000000 }
    },
    "session_end": {
      "minutes": { "type": "number", "min": 0, "max": 1440 },
      "answered": { "type": "int", "min": 0, "max": 100000 }
    }
  }
}
